# Copy this file to .env and fill in ONE provider below.
#
# The app runs with no provider at all -- manual logging, targets, history and
# the charts all work. A provider only enables the Claude-backed features: meal
# analysis, workout parsing and day ratings.
#
# -----------------------------------------------------------------------------
# Option 1: Anthropic (default, paid, best quality)
# -----------------------------------------------------------------------------
# Roughly $0.005 per meal analysis on Sonnet, $0.0025 on Haiku.
# Key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Optional. Must be a model that supports forced tool choice -- Opus 5.5,
# Sonnet 5.5 and Fable 5.1 reject it with a 400.
# MACRO_TRACKER_MODEL=claude-haiku-4-5

# -----------------------------------------------------------------------------
# Option 2: a free hosted provider
# -----------------------------------------------------------------------------
# These speak the OpenAI chat-completions dialect, which the app translates to.
# Free-tier terms and model catalogues change often -- check the linked page for
# a current model id rather than trusting an example below.
#
# Groq -- https://console.groq.com/docs/models
# MACRO_TRACKER_PROVIDER=groq
# MACRO_TRACKER_MODEL=<model id>
# GROQ_API_KEY=
#
# Google Gemini -- https://ai.google.dev/gemini-api/docs/models
# MACRO_TRACKER_PROVIDER=gemini
# MACRO_TRACKER_MODEL=<model id>
# GEMINI_API_KEY=
#
# OpenRouter -- https://openrouter.ai/models
# MACRO_TRACKER_PROVIDER=openrouter
# MACRO_TRACKER_MODEL=<model id>
# OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Option 3: fully local and free, via Ollama (https://ollama.com)
# -----------------------------------------------------------------------------
# Pull a model with tool-calling support, then `ollama serve`. No key needed.
# Expect much slower responses without a discrete GPU, and weaker estimates.
# MACRO_TRACKER_PROVIDER=ollama
# MACRO_TRACKER_MODEL=<name from `ollama list`>

# -----------------------------------------------------------------------------
# Option 4: any other OpenAI-compatible endpoint
# -----------------------------------------------------------------------------
# MACRO_TRACKER_PROVIDER=openai
# MACRO_TRACKER_BASE_URL=https://your-endpoint/v1
# MACRO_TRACKER_MODEL=<model id>
# MACRO_TRACKER_API_KEY=

# -----------------------------------------------------------------------------
# Storage
# -----------------------------------------------------------------------------
# Where the SQLite file lives; useful for a mounted volume.
# MACRO_TRACKER_DB=/data/macro_tracker.db
