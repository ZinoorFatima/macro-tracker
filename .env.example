# Copy this file to .env and paste your Anthropic API key below.
# Get one at https://console.anthropic.com/settings/keys
#
# The app runs without a key -- manual logging, targets, history and the charts
# all work. The key only enables the Claude-backed features: meal analysis,
# workout parsing and day ratings.
ANTHROPIC_API_KEY=

# Optional. Any model that supports forced tool choice.
# MACRO_TRACKER_MODEL=claude-sonnet-5

# Optional. Where the SQLite file lives; useful for a mounted volume.
# MACRO_TRACKER_DB=/data/macro_tracker.db
